{
  "name": "faz-o-l",
  "version": "1.0.0",
  "description": "Faz o L \u2014 compartilhamento de tela com baixa lat\u00eancia para servidores do Discord",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/start.js",
    "dev": "node --watch src/start.js",
    "check": "for f in src/*.js public/app.js; do node --check $f || exit 1; done",
    "test": "node --test telemetry.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-logs": "0.223.2",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "discord.js": "^14.16.3",
    "express": "^4.21.2",
    "livekit-client": "^2.9.0",
    "livekit-server-sdk": "^2.9.0"
  }
}
