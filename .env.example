# ------------------------------------------------------------------
# Faz o L — configuração
# O ./install.sh gera este arquivo pra você. Copie para .env se preferir
# configurar na mão:  cp .env.example .env
# ------------------------------------------------------------------

# Domínio apontando (registro A) para o IP da VPS. Obrigatório (HTTPS é exigido pelo navegador).
DOMAIN=live.seudominio.com

# Quem cuida do HTTPS (o install.sh escolhe sozinho):
#   VPS limpa ............ docker-compose.yml:docker-compose.caddy.yml
#   Coolify / Traefik .... docker-compose.yml:docker-compose.traefik.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml

# Chaves internas do LiveKit (gere valores aleatórios longos)
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# IP público da VPS (opcional; se vazio é detectado automaticamente)
LIVEKIT_NODE_IP=
# Versão da imagem do LiveKit (ex.: v1.13.11).
LIVEKIT_VERSION=v1.13.11

# Segredo para assinar o cookie de login
SESSION_SECRET=troque-por-outro-segredo-aleatorio

# Limites
MAX_STREAMERS=2
MAX_VIEWERS=15
ROOM_NAME=faz-o-l

# ---------------- Discord (tudo opcional) ----------------
# Developer Portal > sua aplicação > OAuth2
# Com CLIENT_ID + CLIENT_SECRET o login é feito pela conta do Discord.
# Sem eles, qualquer pessoa com o link entra digitando um apelido.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot: canais por servidor, comandos /live e /convite, avisos e clipes no Discord
DISCORD_BOT_TOKEN=
# Quem pode colocar o bot num servidor do Discord e criar um canal de transmissão
# (IDs de usuário do Discord, separados por vírgula). Cada servidor vira um canal;
# o dono convida a galera por link. Os canais de aviso e de clipes são escolhidos no site.
CREATOR_DISCORD_IDS=

# Só pra migrar a versão antiga (sala única): o servidor e os canais de aviso dela
DISCORD_GUILD_ID=
DISCORD_NOTIFY_CHANNEL_ID=
DISCORD_CLIPS_CHANNEL_ID=
